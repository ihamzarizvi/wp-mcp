{
  "name": "wp-mcp",
  "version": "0.1.0",
  "description": "Multi-site WordPress MCP server: full admin control of many WordPress sites from any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wp-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bridge-plugin",
    "sites.example.json",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test:site": "npx -y @wp-playground/cli@3.0.22 server --port=9400 --blueprint=tests/integration/blueprint.json --mount-dir ./bridge-plugin/wp-mcp-bridge /wordpress/wp-content/plugins/wp-mcp-bridge --mount-dir ./.playground/out /wordpress/wp-content/mcp-out",
    "test:integration": "node tests/integration/run.mjs"
  },
  "keywords": [
    "mcp",
    "wordpress",
    "woocommerce",
    "model-context-protocol"
  ],
  "author": "Hamza Rizvi (https://hamzarizvi.com)",
  "homepage": "https://hamzarizvi.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
