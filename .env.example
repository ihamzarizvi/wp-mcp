# One secret per site, referenced from sites.json.
# Connection key (keyEnv): WP Admin > WP MCP > Create connection key.
WP_SITE_EXAMPLE_KEY="wpmcp_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Application Password (appPasswordEnv): WP Admin > Users > Profile > Application Passwords.
WP_SITE_EXAMPLE2_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Optional: path to sites.json (default: sites.json next to package.json)
# WP_MCP_SITES=C:/path/to/sites.json

# HTTP transport (node dist/index.js --http). The token is required.
# WP_MCP_TOKEN=change-me-to-a-long-random-string
# WP_MCP_HOST=127.0.0.1
# WP_MCP_PORT=3939
