# One Application Password per site, referenced by "appPasswordEnv" in sites.json.
# Create it in WP Admin > Users > Profile > Application Passwords.
WP_SITE_EXAMPLE_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Optional: path to sites.json (default: sites.json next to package.json)
# WP_MCP_SITES=C:/path/to/sites.json

# HTTP transport (node dist/index.js --http). The token is required.
# WP_MCP_TOKEN=change-me-to-a-long-random-string
# WP_MCP_HOST=127.0.0.1
# WP_MCP_PORT=3939
